<Window x:Class="GameLauncher.Views.SteamApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chave da API Steam"
        Width="520" Height="320" MinWidth="480" MinHeight="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#16213E"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="A chave API Steam foi rejeitada (401)." FontSize="16"
                       FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#B6C4D8" FontSize="12">
                Gere ou confira sua chave no site oficial da Steam e informe-a abaixo. A chave sera protegida no arquivo local de configuracoes.
            </TextBlock>
            <TextBlock Margin="0,6,0,0" FontSize="12">
                <Hyperlink NavigateUri="https://steamcommunity.com/dev/apikey"
                           RequestNavigate="Hyperlink_RequestNavigate" Foreground="#69B9FF">
                    steamcommunity.com/dev/apikey
                </Hyperlink>
            </TextBlock>
        </StackPanel>
        <PasswordBox x:Name="KeyBox" Grid.Row="1" Height="42" Padding="10,8"
                     VerticalAlignment="Center" FontSize="13" ToolTip="Chave API Steam"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCELAR" IsCancel="True" MinWidth="100" MinHeight="38"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="SALVAR E TENTAR" MinWidth="150" MinHeight="38"
                    FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
