<Window x:Class="GameLauncher.Views.PlatformLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Biblioteca de jogos" Width="1120" Height="760"
        MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F1F4F8">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PlatformTitle" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="AccountText" FontSize="13" Foreground="#91A0B2" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="ABRIR PLATAFORMA" Click="OpenClient_Click" Padding="12,8" Margin="0,0,8,0"
                        MinHeight="38" MinWidth="138" FontSize="11" VerticalContentAlignment="Center"/>
                <Button x:Name="DisconnectButton" Content="DESCONECTAR" Click="Disconnect_Click" Padding="12,8"
                        Foreground="#FF7777" MinHeight="38" MinWidth="112" FontSize="11" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="36" Padding="10,7" Background="#171D26"
                     Foreground="White" BorderBrush="#344254" ToolTip="Pesquisar jogos"
                     TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="StatusFilter" Grid.Column="1" Height="36" Margin="10,0,0,0"
                      SelectedIndex="0" SelectionChanged="StatusFilter_SelectionChanged"
                      Background="#171D26" Foreground="White">
                <ComboBoxItem Content="Todos"/>
                <ComboBoxItem Content="Instalados"/>
                <ComboBoxItem Content="Disponiveis"/>
            </ComboBox>
            <TextBlock x:Name="CountText" Grid.Column="2" Foreground="#91A0B2" VerticalAlignment="Center" Margin="18,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl x:Name="GamesItems" ItemsSource="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="190" Height="340" Margin="0,0,14,16" CornerRadius="12"
                                    Background="#18212C" BorderBrush="#2C3948" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="204"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="11,11,0,0" ClipToBounds="True" Background="#222D3A">
                                        <Grid>
                                            <md:PackIcon Kind="GamepadVariant" Width="42" Height="42" Foreground="#65758A"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="12,10,12,10">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#91A0B2" Margin="0,5,0,8"/>
                                        <Button Content="{Binding ActionText}" Click="GameAction_Click" Padding="8,6"
                                                HorizontalAlignment="Stretch" MinHeight="38" VerticalContentAlignment="Center"
                                                Background="#00C878" Foreground="#07140F" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="Nenhum jogo encontrado nesta biblioteca."
                           Foreground="#91A0B2" FontSize="15" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="NoticeText" Foreground="#718096" FontSize="11"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
</Window>
