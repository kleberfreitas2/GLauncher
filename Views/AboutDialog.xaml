<Window x:Class="GameLauncher.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sobre o GLauncher"
        Width="620" Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1527"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="AboutActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8D7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AboutPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AboutActionButtonStyle}">
            <Setter Property="Background" Value="#00D982"/>
            <Setter Property="Foreground" Value="#07120D"/>
            <Setter Property="BorderBrush" Value="#00E676"/>
        </Style>
        <Style x:Key="AboutSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AboutActionButtonStyle}">
            <Setter Property="Background" Value="#202B45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#425477"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151B30" CornerRadius="14" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <Image Source="/Assets/icon.png" Width="130" Height="130"
                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="GLauncher" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="30,8,0,0" VerticalAlignment="Center">
            <TextBlock Text="Sobre o GLauncher" FontSize="25" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" FontSize="15" Foreground="#00E676" Margin="0,8,0,20"/>
            <TextBlock Text="Desenvolvido por Kleber Freitas" FontSize="14" Foreground="#AABBCC"/>
            <TextBlock Text="Game Launcher para Windows" FontSize="13" Foreground="#7788AA" Margin="0,4,0,14"/>
            <TextBlock x:Name="RepositoryLink"
                       Foreground="#66C0F4" TextDecorations="Underline" Cursor="Hand"
                       MouseLeftButtonUp="GitHub_Click"/>
            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="#BBAADD"
                       FontSize="12" Margin="0,18,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="UpdateButton" Content="ABRIR RELEASES"
                        Style="{StaticResource AboutPrimaryButtonStyle}"
                        Click="Update_Click" Margin="0,0,10,0"/>
                <Button Content="OK" Style="{StaticResource AboutSecondaryButtonStyle}"
                        Click="Ok_Click" MinWidth="72"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
