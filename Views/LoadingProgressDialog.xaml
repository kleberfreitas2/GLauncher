<Window x:Class="GameLauncher.Views.LoadingProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ctrl="clr-namespace:GameLauncher.Controls"
        Title="Carregando..."
        Width="520" MinHeight="300" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#16213E"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="Buscando informacoes do jogo..."
                   FontSize="15" FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Stretch" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Viewbox Grid.Row="1" Width="120" Height="120"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <ctrl:ArcGauge x:Name="ProgressGauge" Value="0" Label="Progresso"/>
        </Viewbox>

        <TextBlock x:Name="StepText" Grid.Row="2"
                   Text="Iniciando..."
                   FontSize="12" Foreground="#AAAAAA"
                   HorizontalAlignment="Stretch" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
