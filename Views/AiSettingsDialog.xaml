<Window x:Class="GameLauncher.Views.AiSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar assistente IA" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#111827" Foreground="#F3F4F6" FontFamily="Segoe UI">
    <StackPanel Margin="28">
        <TextBlock Text="Seu assistente, sua escolha" FontSize="23" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="Escolha o serviço e informe sua chave pessoal. Limites e cobranças dependem da sua conta no provedor."
                   TextWrapping="Wrap" Margin="0,0,0,20"/>
        <TextBlock Text="Provedor" Margin="0,0,0,6"/>
        <ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed" MinHeight="40" Foreground="White"/>
        <TextBlock Text="Chave API" Margin="0,18,0,6"/>
        <PasswordBox x:Name="KeyBox" MinHeight="42" Padding="8" Foreground="White"/>
        <TextBlock Text="A chave será protegida para seu usuário do Windows. As mensagens são enviadas ao serviço selecionado."
                   TextWrapping="Wrap" Foreground="#AAB6C7" Margin="0,10,0,14"/>
        <TextBlock><Hyperlink Click="GetKey_Click" Foreground="#9BC4FF">Obter chave no site do provedor</Hyperlink></TextBlock>
        <TextBlock x:Name="ValidationText" Foreground="#FFAAAA" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" MinWidth="100" Margin="0,0,12,0"/>
            <Button Content="Salvar" Click="Save_Click" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
