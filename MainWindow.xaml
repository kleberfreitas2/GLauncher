                <Border Grid.RowSpan="4" Panel.ZIndex="5" Background="#E6080B12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBigPictureDetailsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Background="#161C27" BorderBrush="#536176" BorderThickness="1" CornerRadius="18" Padding="34" MaxWidth="900" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding DetailGame.DisplayName}" FontSize="30" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailGame.SummaryDisplay}" FontSize="16" Foreground="#D3D9E3" TextWrapping="Wrap" Margin="0,16,0,16"/>
                            <TextBlock Text="{Binding DetailGame.PlatformsDisplay, StringFormat='Plataformas: {0}'}" FontSize="13" Foreground="#AAB6C7" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailGame.DevelopersDisplay, StringFormat='Desenvolvedor: {0}'}" FontSize="13" Foreground="#AAB6C7" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="Pressione B ou X para fechar" FontSize="11" Foreground="#8491A3" Margin="0,22,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="BpTransitionOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="10000"
              IsHitTestVisible="False"
              Visibility="Collapsed">

            <Image x:Name="BpIntroImage"
                   Source="{Binding DetailGame.EffectiveBackgroundPath, Converter={StaticResource PathToImageConverter}}"
                   Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="BpIntroImageScale" ScaleX="1.08" ScaleY="1.08"/>
                </Image.RenderTransform>
            </Image>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A9000000" Offset="0"/>
                        <GradientStop Color="#55000000" Offset="0.5"/>
                        <GradientStop Color="#C9000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="BpFlash"
                    Background="White"
                    Opacity="0"/>


            <Border x:Name="BpVignette" Opacity="0">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                        <GradientStop Color="Transparent"  Offset="0.0"/>
                        <GradientStop Color="Transparent"  Offset="0.4"/>
                        <GradientStop Color="#CC000000"    Offset="0.75"/>
                        <GradientStop Color="#FF000000"    Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>


            <ItemsControl x:Name="BpScanLines" Opacity="0" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>


            <Grid x:Name="BpLogoContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="520" Height="360"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BpLogoScale" ScaleX="0.3" ScaleY="0.3"/>
                </Grid.RenderTransform>
                <Grid.Effect>
                    <DropShadowEffect x:Name="BpLogoGlow"
                                      Color="#107C10"
                                      BlurRadius="60"
                                      ShadowDepth="0"
                                      Opacity="0"/>
                </Grid.Effect>


                <Ellipse x:Name="BpLogoBg" Grid.Row="0"
                         Width="180" Height="180"
                         Fill="#CC000000"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="2"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BpPulseScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>


                <md:PackIcon Grid.Row="0" Kind="TelevisionPlay"
                             Width="72" Height="72"
                             Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,0,0,10"/>


                <TextBlock Grid.Row="1" Text="BIG PICTURE"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock Grid.Row="2" Text="{Binding DetailGame.DisplayName, TargetNullValue='PREPARE-SE PARA JOGAR'}"
                           FontSize="18" FontWeight="SemiBold" Foreground="#DCE5F2"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="30,10,30,0"/>
            </Grid>


            <Border x:Name="BpBarLeft"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Height="0" Background="#F0080B12" Opacity="0.95"/>
            <Border x:Name="BpBarRight"
                    HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Height="0" Background="#F0080B12" Opacity="0.95"/>


            <Border x:Name="BpFadeOut"
                    Background="Black"
                    Opacity="0"/>
        </Grid>
    </Grid>
</Window>


