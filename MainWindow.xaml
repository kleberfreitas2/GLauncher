<Window x:Class="GameLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:ctrl="clr-namespace:GameLauncher.Controls" xmlns:converters="clr-namespace:GameLauncher.Converters" xmlns:vm="clr-namespace:GameLauncher.ViewModels" Title="GLauncher" Icon="Assets/icon.ico" Height="700" Width="1200" MinHeight="500" MinWidth="800" WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontFamily="{DynamicResource MaterialDesignFont}" Background="{DynamicResource AppBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="GamepadFocusBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEEEF4"/>
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8D8E2"/>
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="252*"/>
            <RowDefinition Height="275*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image x:Name="LogoIcon" Source="Assets/icon.png" Width="36" Height="36" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                           MouseDown="LogoIcon_MouseDown"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                        <Image.ToolTip>
                            <ToolTip Content="GLauncher" FontFamily="Segoe UI"/>
                        </Image.ToolTip>
                    </Image>
                    <TextBlock FontSize="17" FontWeight="Bold" VerticalAlignment="Center">
            <Run Text="G" Foreground="{DynamicResource AccentGreenBrush}"/><Run Text="Launcher" Foreground="White"/>
                    </TextBlock>
                </StackPanel>

                <!-- Easter Egg Overlay -->
                <Popup x:Name="EasterEggPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=LogoIcon}"
                       AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
                    <Border x:Name="EasterEggBorder" CornerRadius="20" Padding="0"
                            Background="Transparent" Width="380">
                        <Border.Effect>
                            <DropShadowEffect Color="#00E676" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <Border Background="#0D1117" CornerRadius="20" ClipToBounds="True">
                            <!-- Faixa verde topo -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="20,20,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E676" Offset="0"/>
                                            <GradientStop Color="#00B0FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="28,20,28,24">
                                    <!-- Header com logo e título -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Image x:Name="EggLogoSpin" Source="Assets/icon.png" Width="52" Height="52"
                                               RenderTransformOrigin="0.5,0.5" Margin="0,0,14,0">
                                            <Image.RenderTransform>
                                                <RotateTransform x:Name="EggLogoRotate" Angle="0"/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="26" FontWeight="Black" FontFamily="Segoe UI Black">
                                                <Run Text="G" Foreground="#00E676"/><Run Text="Launcher" Foreground="White"/>
                                            </TextBlock>
                                            <Border Background="#1A2A1A" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                <TextBlock Text="v 2.9.0" FontSize="11" FontWeight="Bold"
                                                           Foreground="#00E676" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Separador gradiente -->
                                    <Border Height="1" Margin="0,0,0,14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#00E676" Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Mensagem divertida -->
                                    <TextBlock x:Name="EggFunText"
                                               Text="🎮 Você encontrou o Easter Egg!" 
                                               FontSize="14" FontWeight="Bold" Foreground="#00E676"
                                               HorizontalAlignment="Center" FontFamily="Segoe UI"
                                               Margin="0,0,0,8"/>

                                    <!-- Sobre -->
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#AABBCC"
                                               FontFamily="Segoe UI" HorizontalAlignment="Center"
                                               TextAlignment="Center" Margin="0,0,0,14">
                                        <Run Text="Criado com "/> 
                                        <Run Text="❤️"/> 
                                        <Run Text=" para gamers de verdade."/>
                                        <LineBreak/>
                                        <Run Text="Um launcher feito para centralizar suas plataformas,"/>
                                        <LineBreak/>
                                        <Run Text="jogos e diversão — tudo em um só lugar."/>
                                    </TextBlock>

                                    <!-- Stats divertidos -->
                                    <Border Background="#0A1628" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="🕹️" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Xbox" FontSize="10" Foreground="#667788" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                                <TextBlock Text="Steam" FontSize="10" Foreground="#667788" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                                <TextBlock Text="Epic" FontSize="10" Foreground="#667788" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="🤖" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="IA Gamer" FontSize="10" Foreground="#667788" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                                <TextBlock Text="integrada" FontSize="10" Foreground="#667788" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="📺" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Big Picture" FontSize="10" Foreground="#667788" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                                <TextBlock Text="para TVs" FontSize="10" Foreground="#667788" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Créditos -->
                                    <TextBlock FontSize="11" Foreground="#445566" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center" TextAlignment="Center">
                                        <Run Text="© 2025 GLauncher • Feito no Brasil 🇧🇷"/>
                                    </TextBlock>

                                    <!-- Botão fechar -->
                                    <Button x:Name="EggCloseBtn" Click="EggCloseBtn_Click"
                                            Margin="0,14,0,0" HorizontalAlignment="Center"
                                            Cursor="Hand" Background="#00E676" Foreground="#0D1117"
                                            BorderThickness="0" Padding="24,8" FontWeight="Bold"
                                            FontSize="12" FontFamily="Segoe UI">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBd" Background="{TemplateBinding Background}"
                                                        CornerRadius="20" Padding="{TemplateBinding Padding}"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBd" Property="Background" Value="#00FF88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CloseBd" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        Valeu por explorar! 🚀
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </Popup>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel.Resources>

                        <Style TargetType="md:PackIcon">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                        </Style>
                    </StackPanel.Resources>

                    <Border Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GamepadFocusBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FocusedHeaderItem}" Value="Xbox">
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding OpenXboxProfileCommand}"
                            Cursor="Hand" BorderThickness="0"
                            ToolTip="Xbox Live">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="XboxBd" CornerRadius="22" Padding="14,8"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#107C10"/>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#107C10" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <md:PackIcon Kind="MicrosoftXbox" Width="20" Height="20" Foreground="White"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding XboxButtonText}" FontSize="12" FontWeight="Bold"
                                                   FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
                                            <Border CornerRadius="10" Background="#22FFFFFF" Padding="8,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsXboxLoggedIn}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="Trophy" Width="12" Height="12" Foreground="#FFD700"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding XboxProfile.Gamerscore, StringFormat='{}{0:N0}'}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#FFD700"
                                                           VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="XboxBd" Property="Background" Value="#0E6B0E"/>
                                            <Setter TargetName="XboxBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="XboxBd" Property="Background" Value="#0A5A0A"/>
                                            <Setter TargetName="XboxBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <Border Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GamepadFocusBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FocusedHeaderItem}" Value="Steam">
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding OpenSteamProfileCommand}"
                            Cursor="Hand" BorderThickness="0"
                            ToolTip="Steam">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="SteamBd" CornerRadius="22" Padding="14,8"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1B2838"/>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#1B2838" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <md:PackIcon Kind="Steam" Width="20" Height="20" Foreground="White"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding SteamButtonText}" FontSize="12" FontWeight="Bold"
                                                   FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
                                            <Border CornerRadius="10" Background="#22FFFFFF" Padding="8,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSteamConnected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="GamepadVariant" Width="12" Height="12" Foreground="#66C0F4"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SteamProfile.OwnedGamesCount, StringFormat='{}{0:N0}'}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#66C0F4"
                                                           VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SteamBd" Property="Background" Value="#2A475E"/>
                                            <Setter TargetName="SteamBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="SteamBd" Property="Background" Value="#171A21"/>
                                            <Setter TargetName="SteamBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <Border Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GamepadFocusBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FocusedHeaderItem}" Value="Epic">
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding OpenEpicProfileCommand}"
                            Cursor="Hand" BorderThickness="0"
                            ToolTip="Epic Games">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="EpicBd" CornerRadius="22" Padding="14,8"
                                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#000000"/>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.6"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="Assets/epic_logo.png" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding EpicButtonText}" FontSize="12" FontWeight="Bold"
                                                   FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
                                            <Border CornerRadius="10" Background="#22FFFFFF" Padding="8,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEpicConnected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="GamepadVariant" Width="12" Height="12" Foreground="#00B4D8"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding EpicProfile.InstalledGamesCount, StringFormat='{}{0:N0}'}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#00B4D8"
                                                           VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="EpicBd" Property="Background" Value="#2A2A2A"/>
                                            <Setter TargetName="EpicBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="EpicBd" Property="Background" Value="#111111"/>
                                            <Setter TargetName="EpicBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <Button Click="BtnYoutube_Click" Style="{StaticResource HeaderActionButton}"
                            Background="#FF0000" Foreground="White" Padding="14,8"
                            Cursor="Hand" ToolTip="Inscreva-se no canal CarecaRetrô"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Youtube" Width="18" Height="18"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="INSCREVA-SE" FontSize="11" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenDonationCommand}" VerticalAlignment="Center"
                            Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0"
                            ToolTip="Apoie o projeto via PIX" Margin="0,0,14,0">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="DonateBd" Background="#18FFFFFF" CornerRadius="22" Padding="14,8"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF5252" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <md:PackIcon Kind="Heart" Width="20" Height="20" Foreground="#FF5252"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="DOAR" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DonateBd" Property="Background" Value="#30FFFFFF"/>
                                        <Setter TargetName="DonateBd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="DonateBd" Property="Background" Value="#20FFFFFF"/>
                                        <Setter TargetName="DonateBd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Margin="0,0,18,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GamepadFocusBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FocusedHeaderItem}" Value="Help">
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding OpenHelpCommand}"
                            VerticalAlignment="Center"
                            Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0"
                            ToolTip="Manual de utilização">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="HelpBd" Background="Transparent" CornerRadius="14" Padding="4">
                                        <md:PackIcon Kind="HelpCircle" Width="24" Height="24" Foreground="#2196F3"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HelpBd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                    <Border VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding GamepadStatus}">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <md:PackIcon Kind="MicrosoftXboxController" Width="20" Height="20" Foreground="#556677" VerticalAlignment="Center">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GamepadConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                                <md:PackIcon Kind="MicrosoftXboxController" Width="20" Height="20" Foreground="#00E676"
                               VerticalAlignment="Center">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GamepadConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                    <md:PackIcon.Effect>
                                        <DropShadowEffect Color="#00E676" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </md:PackIcon.Effect>
                                </md:PackIcon>
                            </Grid>
                            <Border Margin="6,0,0,0" CornerRadius="8" Background="#22FFFFFF" Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasGamepadBattery, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0">
                                        <md:PackIcon.Style>
                                            <Style TargetType="md:PackIcon">
                                                <Setter Property="Kind" Value="Battery"/>
                                                <Setter Property="Foreground" Value="#00E676"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery10">
                                                        <Setter Property="Kind" Value="Battery10"/>
                                                        <Setter Property="Foreground" Value="#FF5252"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery40">
                                                        <Setter Property="Kind" Value="Battery40"/>
                                                        <Setter Property="Foreground" Value="#FFD740"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery70">
                                                        <Setter Property="Kind" Value="Battery70"/>
                                                        <Setter Property="Foreground" Value="#69F0AE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery">
                                                        <Setter Property="Kind" Value="Battery"/>
                                                        <Setter Property="Foreground" Value="#00E676"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </md:PackIcon.Style>
                                    </md:PackIcon>
                                    <TextBlock Text="{Binding GamepadBatteryText}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#00E676"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery10">
                                                        <Setter Property="Foreground" Value="#FF5252"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery40">
                                                        <Setter Property="Foreground" Value="#FFD740"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GamepadFocusBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FocusedHeaderItem}" Value="Settings">
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button ToolTip="GLauncher AI — Assistente Gamer"
                            Command="{Binding OpenAiAssistantCommand}"
                            x:Name="BtnAi" Click="BtnAi_Click"
                            Style="{StaticResource HeaderIconButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="AiBd" Background="Transparent" CornerRadius="14" Padding="4">
                                            <md:PackIcon Kind="Robot" Width="20" Height="20" Foreground="#FF3B3B"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AiBd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Botão de Troféus -->
                            <Button ToolTip="Meus Troféus"
                                    Command="{Binding OpenTrophiesCommand}"
                                    Style="{StaticResource HeaderIconButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="TrophyBd" Background="Transparent" CornerRadius="14" Padding="4">
                                            <md:PackIcon Kind="Trophy" Width="20" Height="20"
                                                         Foreground="#FFD700"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TrophyBd" Property="Background" Value="#22FFD700"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>


                            <Button x:Name="BtnGear" Click="BtnGear_Click"
                  ToolTip="Configurações"
                  Style="{StaticResource HeaderIconButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="GearBd" Background="Transparent" CornerRadius="14" Padding="4">
                                            <md:PackIcon Kind="CogOutline" Width="20" Height="20" Foreground="#8899AA"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GearBd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Mode=Self}}">
                                        <ContextMenu.Resources>
                                            <Style x:Key="GameOnlyMenuItemStyle" TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailGame}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Foreground" Value="#777777"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="Adicionar Jogo" Command="{Binding AddGameCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Plus" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Tema" Command="{Binding OpenThemeCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="ThemeLightDark" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Limpar todos os jogos" Command="{Binding ClearAllGamesCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="DeleteSweep" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Configurar assistente IA" Command="{Binding ConfigureAiCommand}"/>
                                        <MenuItem Header="Sobre" Click="About_Click">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="InformationOutline" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sons (Ligar/Desligar)" Command="{Binding ToggleSoundCommand}"
                                          IsCheckable="True" IsChecked="{Binding IsSoundEnabled, Mode=OneWay}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="VolumeHigh" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="FPS Overlay no Jogo (Ligar/Desligar)" Style="{StaticResource GameOnlyMenuItemStyle}" Command="{Binding ToggleFpsOverlayCommand}"
                                          IsCheckable="True" IsChecked="{Binding IsFpsOverlayEnabled, Mode=OneWay}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Speedometer" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Alternar Favorito" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding ToggleFavoriteCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Alterar Imagem" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding ChangeImageCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Alterar Logotipo" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding ChangeLogoCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Buscar Capa Online" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding SearchCoverCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Buscar Fundo (Screenshot/Key Art)" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding SearchBackgroundCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Buscar Info IGDB" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding FetchIgdbInfoCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Re-escanear Tecnologias" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding RescanGameTechCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Gpu" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Recomendação Gráfica (Hardware)" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding OpenHwRecommendationCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Chip" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Renomear" Style="{StaticResource GameOnlyMenuItemStyle}"
                          Command="{Binding RenameGameCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <Separator/>
                                        <MenuItem Header="Remover Jogo" Style="{StaticResource GameOnlyMenuItemStyle}" FontWeight="Bold"
                           Command="{Binding RemoveGameCommand}"
                           CommandParameter="{Binding DetailGame}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>


                    <Button x:Name="BtnBigPicture" Command="{Binding ToggleBigPictureModeCommand}"
                            ToolTip="Modo Big Picture — BETA (em teste para TVs)" Margin="0,0,12,0"
                            Style="{StaticResource HeaderIconButtonStyle}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid>
                                    <Border x:Name="BpBd" Background="Transparent" CornerRadius="14" Padding="4">
                                        <md:PackIcon x:Name="BpIcon" Kind="{Binding BigPictureIcon}" Width="20" Height="20" Foreground="#8899AA"/>
                                    </Border>

                                    <Border Background="#E65100" CornerRadius="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="2,0" Margin="0,-2,-2,0">
                                        <TextBlock Text="BETA" FontSize="6" FontWeight="Bold"
                                                   Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BpBd" Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                        <Setter TargetName="BpIcon" Property="Foreground" Value="#00E676"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding CurrentTime}" FontSize="16" FontWeight="SemiBold"
                     Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                              Cursor="Hand" ToolTip="Clique para alterar avatar"
                              MouseLeftButtonUp="Avatar_Click">

                        <!-- Avatar -->

                        <!-- Gamerscore dos Troféus (estilo Xbox) -->
                        <!-- Avatar -->
                        <Border Width="34" Height="34" CornerRadius="19" ClipToBounds="True"
                                Background="#22334455" BorderThickness="2" BorderBrush="#33FFFFFF">
                            <Grid>
                                <md:PackIcon Kind="AccountCircle" Width="50" Height="34" Foreground="#556677"
                                             Visibility="{Binding HasNoAvatar, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Left" Margin="-10,0,0,0"/>
                                <Image Source="{Binding AvatarPath, ConverterParameter=38, Converter={StaticResource PathToImageConverter}}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <!-- Gamerscore dos Troféus (estilo Xbox) -->
                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding TrophyGamerscoreDisplay}"
                                       FontSize="12" FontWeight="Bold" Foreground="#FFD700"
                                       FontFamily="Segoe UI" LineHeight="14"/>
                            <TextBlock Text="{Binding TrophyCountDisplay}"
                                       FontSize="9" Foreground="#8899AA"
                                       FontFamily="Segoe UI" LineHeight="12"/>
                        </StackPanel>

                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnWinMinimize" Click="BtnWinMinimize_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" ToolTip="Minimizar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="&#x2014;" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnWinMaxRestore" Click="BtnWinMaxRestore_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" ToolTip="Restaurar/Maximizar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <Canvas Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="8" Height="8" Stroke="#AAAAAA" StrokeThickness="1.2" Canvas.Left="3" Canvas.Top="0" Fill="Transparent"/>
                                            <Rectangle Width="8" Height="8" Stroke="#AAAAAA" StrokeThickness="1.2" Canvas.Left="0" Canvas.Top="3" Fill="Transparent"/>
                                        </Canvas>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnWinClose" Click="BtnWinClose_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" ToolTip="Fechar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="&#x2716;" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                            <Setter TargetName="bd" Property="TextElement.Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Margin="0,55,0,0" Grid.RowSpan="3">
            <ctrl:AnimatedImage x:Name="BackgroundAnim"
                          ImagePath="{Binding DetailGame.EffectiveBackgroundPath}"
                          Stretch="UniformToFill" Opacity="0.90"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   UseLayoutRounding="True"
                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                   Visibility="{Binding DetailGame.HasBackground, Converter={StaticResource BoolToVisibility}}"
                   IsHitTestVisible="False"/>
            <Border IsHitTestVisible="False"
              Visibility="{Binding DetailGame.HasBackground, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#10000000" Offset="0"/>
                        <GradientStop Color="#66080810" Offset="0.55"/>
                        <GradientStop Color="#DD0D0D15" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button Grid.RowSpan="3" Command="{Binding AddGameCommand}"
                    Width="168" Height="62"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,20,0"
                    Panel.ZIndex="100" ToolTip="Adicionar um novo jogo"
                    Background="Transparent" BorderThickness="0" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AddGameOverlayBd" Background="#CC0A0A18"
                                BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="12" Padding="12,8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12"
                                                  ShadowDepth="2" Opacity="0.65"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="GamepadVariant" Width="28" Height="28"
                                             Foreground="#C7D0DC" VerticalAlignment="Center"
                                             Margin="0,0,9,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ADICIONAR JOGO" FontSize="11"
                                               FontWeight="Bold" Foreground="#F5F7FA"/>
                                    <TextBlock Text="Clique para adicionar" FontSize="9"
                                               Foreground="#8D99A8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddGameOverlayBd" Property="Background" Value="#E61A2330"/>
                                <Setter TargetName="AddGameOverlayBd" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AddGameOverlayBd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Panel.ZIndex="99"
              Visibility="{Binding IsLoading, ElementName=BackgroundAnim, Converter={StaticResource BoolToVisibility}}"
              Background="#01000000" IsHitTestVisible="True">
                <Border Background="#CC0A0A18" CornerRadius="14"
                  VerticalAlignment="Top" HorizontalAlignment="Center"
                  Margin="0,100,0,0" Padding="30,18">
                    <StackPanel HorizontalAlignment="Center" Width="280">
                        <TextBlock Text="Carregando animação..." FontSize="14" Foreground="#CCDDEE"
                         HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <ProgressBar Value="{Binding LoadingProgress, ElementName=BackgroundAnim, Mode=OneWay}"
                           Minimum="0" Maximum="100" Height="8"
                           Foreground="{DynamicResource AccentBrush}"
                           Background="#33FFFFFF"/>
                        <TextBlock Foreground="#99AABB" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Text>
                                <Binding Path="LoadingProgress" ElementName="BackgroundAnim" StringFormat="{}{0:0}%" Mode="OneWay"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Border>

            <Grid Panel.ZIndex="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border>
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.9">
                            <GradientStop Color="#1A1040" Offset="0"/>
                            <GradientStop Color="#0F0C24" Offset="0.5"/>
                            <GradientStop Color="#0A0A14" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border Opacity="0.12" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.3,0.3" RadiusX="0.4" RadiusY="0.5">
                            <GradientStop x:Name="AccentGradientStop" Color="#107C10" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border Opacity="0.08" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.75,0.7" RadiusX="0.35" RadiusY="0.45">
                            <GradientStop Color="#00E676" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Image Source="Assets/icon.png" Width="72" Height="72" Margin="0,0,0,8"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"
                           x:Name="WelcomeIcon">
                        <Image.Effect>
                            <DropShadowEffect x:Name="WelcomeIconGlow" Color="#107C10" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                        </Image.Effect>
                    </Image>

                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Run Text="Bem-vindo ao " FontSize="28" FontWeight="Light" Foreground="#BBBBCC"/>
                        <Run Text="G" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}"/>
                        <Run Text="Launcher" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="Sua biblioteca de jogos pessoal rápida, elegante e pronta para jogar."
                               FontSize="14" Foreground="#7788AA" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,28"/>

                    <Border Background="#18182A" CornerRadius="16" Padding="32,28" Margin="0,0,0,24"
                            BorderThickness="1" BorderBrush="#222244">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🚀  Comece em 3 passos:" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#CCCCDD" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="1"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Clique no ícone ⚙️ (engrenagem) no canto superior direito"
                                           FontSize="13" Foreground="#99AABB" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Selecione 'Adicionar Jogo' e escolha o executável (.exe)"
                                           FontSize="13" Foreground="#99AABB" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Pronto! Aproveite a experiência com capa, fundo e info automáticas"
                                           FontSize="13" Foreground="#99AABB" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="💡 Dica: Conecte um controle de console para navegar como em um console!"
                               FontSize="11" Foreground="#556677" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Panel.ZIndex="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Área fixa para duas linhas de cards; o ListBox rola quando houver mais jogos. -->
                    <RowDefinition Height="540"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="18,14,0,0"
                        Background="#CC000000"
                        BorderBrush="#E65100" BorderThickness="1"
                        CornerRadius="5" Padding="8,3"
                        Panel.ZIndex="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E65100" CornerRadius="3" Padding="4,1" Margin="0,0,7,0">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="Modo Big Picture — em teste para TVs"
                                   FontSize="10" Foreground="#AABBCC"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Margin="50,0,50,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowDetailPanel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <Image Source="{Binding DetailGame.LogoPath, Converter={StaticResource PathToImageConverter}}"
                   MaxHeight="100" MaxWidth="420"
                   Stretch="Uniform" HorizontalAlignment="Left"
                   Margin="0,0,0,10"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding DetailGame.HasLogo, Converter={StaticResource BoolToVisibility}}">
                            <Image.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.85"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="{Binding DetailGame.DisplayName}"
                       FontSize="38" FontWeight="Bold" Foreground="White"
                       Margin="0,0,0,10" TextWrapping="Wrap"
                       Visibility="{Binding DetailGame.HasNoLogo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>


                <Grid Grid.Row="0" VerticalAlignment="Bottom" Margin="50,0,50,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0" HorizontalAlignment="Left" MaxWidth="720" Padding="28,18" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDetailPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <SolidColorBrush Color="#000000" Opacity="0.7"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Image Source="{Binding DetailGame.LogoPath}" MaxHeight="100" MaxWidth="440"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding DetailGame.DisplayName}" FontSize="32" FontWeight="Bold"
                                           Foreground="White" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#AABBCC" Margin="0,0,20,0">
                                    <Run Text="⏱" /><Run Text=" "/><Run Text="{Binding DetailGame.PlayTimeDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#AABBCC" Margin="0,0,20,0">
                                    <Run Text="🎮" /><Run Text=" "/><Run Text="{Binding DetailGame.GenresDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#FFD700">
                                    <Run Text="★" /><Run Text=" "/><Run Text="{Binding DetailGame.RatingDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding DetailGame.SummaryDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="#99AABB"
                                       TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#667788" Margin="0,0,24,0">
                                    <Run Text="Última vez:" /><Run Text=" "/><Run Text="{Binding DetailGame.LastPlayedText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#667788" Text="{Binding DetailGame.PlatformSource}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Stretch" Padding="22,16" CornerRadius="14" Margin="16,0,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="#000000" Opacity="0.5"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctrl:ArcGauge Value="{Binding CpuUsage}" Label="CPU" Margin="6,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.65" ScaleY="1.65"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                            <ctrl:ArcGauge Value="{Binding GpuUsage}" Label="GPU" Margin="6,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.65" ScaleY="1.65"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                            <ctrl:ArcGauge Value="{Binding RamUsage}" Label="RAM" Margin="6,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.65" ScaleY="1.65"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Padding="30,18,30,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0,2,0,2"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveZone}" Value="{x:Static vm:MainViewModel+NavZone.Carousel}">
                                    <Setter Property="BorderBrush" Value="#4400E676"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#44000010" Offset="0"/>
                            <GradientStop Color="#88080815" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Visibility="Collapsed" Command="{Binding AddGameCommand}"
                                Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="155" Height="210" BorderThickness="0"
                                ToolTip="Adicionar um novo jogo">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddGameBd" Width="155" Height="210"
                                            CornerRadius="10" BorderThickness="2"
                                            BorderBrush="#00E676" Background="#18182A"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00E676" BlurRadius="18"
                                                              ShadowDepth="0" Opacity="0.28"/>
                                        </Border.Effect>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="58" Height="58" CornerRadius="29"
                                                    Background="#2200E676" BorderBrush="#00E676"
                                                    BorderThickness="1" HorizontalAlignment="Center">
                                                <md:PackIcon Kind="Plus" Width="30" Height="30"
                                                             Foreground="#00E676"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="ADICIONAR JOGO" FontSize="12"
                                                       FontWeight="Bold" Foreground="#00E676"
                                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                            <TextBlock Text="Clique para adicionar" FontSize="10"
                                                       Foreground="#7788AA" HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AddGameBd" Property="Background" Value="#222442"/>
                                            <Setter TargetName="AddGameBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="AddGameBd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#00E676" BlurRadius="28"
                                                                      ShadowDepth="0" Opacity="0.6"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="AddGameBd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ListBox Grid.Column="1" ItemsSource="{Binding GamesView}"
                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="False"
                     x:Name="GameCarousel"
                     Focusable="True" IsTabStop="True"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     PreviewKeyDown="GameCarousel_PreviewKeyDown"
                     SelectionChanged="GameCarousel_SelectionChanged"
                      Padding="0,8,20,18">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="10,18"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">

                                                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <Border x:Name="Glow" CornerRadius="13" Margin="-4"
                                                            BorderThickness="2.5" BorderBrush="{DynamicResource AccentBrush}" Opacity="0"
                                                            IsHitTestVisible="False">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#107C10" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border x:Name="Bd" Width="155" Height="210"
                                                            CornerRadius="10" ClipToBounds="True"
                                                            Background="#44000000" Cursor="Hand">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000"
                                                                              BlurRadius="16"
                                                                              ShadowDepth="5"
                                                                              Direction="270"
                                                                              Opacity="0.68"/>
                                                        </Border.Effect>
                                                        <Grid>
                                                            <Grid.Clip>
                                                                <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,155,210"/>
                                                            </Grid.Clip>
                                                            <ContentPresenter/>
                                                            <Border x:Name="Shine" CornerRadius="10" Opacity="0" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                                                                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                                                                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.10" Duration="0:0:0.25">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.10" Duration="0:0:0.25">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                      To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                      To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.10" Duration="0:0:0.3">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.10" Duration="0:0:0.3">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Glow"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="1" Duration="0:0:0.35">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Shine"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="1" Duration="0:0:0.4">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Glow"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Shine"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsBigPictureMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Margin" Value="14,24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="CardRoot" Background="#1A2533" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ContextMenuOpening="GameCardContextMenu_Opening">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <ContextMenu.Resources>
                                                    <Style TargetType="{x:Type MenuItem}">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter Property="Background" Value="#1ED76B"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="Alternar Favorito"
                                                          Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Alterar Imagem"
                                                          Command="{Binding PlacementTarget.Tag.ChangeImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Buscar Capa Online"
                                                          Command="{Binding PlacementTarget.Tag.SearchCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Buscar Fundo (Screenshot/Key Art)"
                                                          Command="{Binding PlacementTarget.Tag.SearchBackgroundCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Buscar Info IGDB"
                                                          Command="{Binding PlacementTarget.Tag.FetchIgdbInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
